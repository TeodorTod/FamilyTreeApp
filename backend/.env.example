# Copy this file to .env and replace placeholder values. Never commit .env.

# App: localhost defaults suitable for development.
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Database: PostgreSQL connection string. Use your own database/user/password.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/familytree?schema=public

# Auth: use a long, random secret outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Media: absolute path recommended in production; relative path is resolved from backend/.
MEDIA_ROOT=./media

# Google OAuth: optional; leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/redirect

# Brevo email: optional; email delivery fails when BREVO_API_KEY is blank.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=FamilyTree
BREVO_REPLYTO_EMAIL=
BREVO_REPLYTO_NAME=
# Optional contact-form destination; defaults to the configured support address.
CONTACT_FORM_RECIPIENT=

# reCAPTCHA: optional; verification is disabled when the secret is blank.
RECAPTCHA_SECRET_KEY=
# Score threshold from 0 to 1. Google recommends starting near 0.5.
RECAPTCHA_MIN_SCORE=0.5

# Stripe: optional; billing endpoints return 503 when STRIPE_SECRET_KEY is blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required only when Stripe billing is enabled.
STRIPE_PRICE_SIX_MONTHS=
STRIPE_PRICE_ONE_YEAR=
STRIPE_PRICE_TWO_YEARS=
